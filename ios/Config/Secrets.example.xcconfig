// Skopiuj ten plik jako Secrets.xcconfig (jest w .gitignore) i uzupełnij.
// UWAGA: w plikach .xcconfig "//" rozpoczyna komentarz, dlatego podajemy
// sam host projektu bez "https://".
//
// Supabase Dashboard → Project Settings → API

SUPABASE_HOST = twoj-projekt.supabase.co
SUPABASE_ANON_KEY = wklej-tutaj-anon-public-key

// Prefiks identyfikatorów aplikacji i zespół do podpisywania.
// Zmień na swój (musi być unikalny w App Store Connect / Twoim koncie).
BUNDLE_ID_PREFIX = com.kubach7
DEVELOPMENT_TEAM =
