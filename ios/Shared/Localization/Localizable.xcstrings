    "update.guide.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple only lets apps from outside the App Store update through a computer. Free: the same way as the install. With TestFlight (paid Apple Developer account) updating would be one button."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple pozwala aplikacjom spoza App Store aktualizować się tylko przez komputer. Bez kosztów: ten sam sposób co instalacja. Przez TestFlight (płatne konto Apple Developer) aktualizacja byłaby jednym przyciskiem."
          }
        }
      }
    },
    "update.guide.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your iPhone to your Mac with a cable."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podłącz iPhone'a kablem do Maca."
          }
        }
      }
    },
    "update.guide.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your Mac, open Terminal and paste this command:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na Macu otwórz Terminal i wklej tę komendę:"
          }
        }
      }
    },
    "update.guide.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the project in Xcode and press ▶ (with your iPhone selected at the top)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz projekt w Xcode i kliknij ▶ (u góry wybrany Twój iPhone)."
          }
        }
      }
    },
    "update.guide.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
