    "update.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data, the e-bike catalog and prices refresh on their own. New app versions are installed from your Mac – the steps appear here when one is ready."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane, katalog e-bike'ów i ceny odświeżają się same. Nową wersję aplikacji instalujesz z Maca – instrukcja pojawi się tutaj, gdy będzie dostępna."
          }
        }
      }
    },
    "update.guide.copied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied"
          }
        },
        "pl": {
