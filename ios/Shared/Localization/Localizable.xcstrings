{
  "sourceLanguage": "pl",
  "strings": {
    "account.delete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account and all data"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń konto i wszystkie dane"
          }
        }
      }
    },
    "account.deleteConfirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure? This permanently deletes your account, goals, deposits and photos. This cannot be undone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na pewno? To trwale usunie konto, cele, wpłaty i zdjęcia. Tego nie da się cofnąć."
          }
        }
      }
    },
    "account.deleteYes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete forever"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń na zawsze"
          }
        }
      }
    },
