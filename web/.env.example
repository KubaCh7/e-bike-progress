# Skopiuj jako web/.env (plik jest w .gitignore).
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://twoj-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=wklej-tutaj-anon-public-key

# Ścieżka bazowa (dla GitHub Pages: /e-bike-progress/, dla Vercel: /)
VITE_BASE=/

# Dane administratora do polityki prywatności i regulaminu (wyświetlane publicznie)
VITE_LEGAL_OWNER=Imię Nazwisko
VITE_LEGAL_CONTACT=kontakt@example.com
